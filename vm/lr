[build]
    run: gcc -g main.c stack.c -o main -Wall -Wextra
    end

[clean]
    run: del main.exe
    end

[run]
    silent: 0
    time_start: runtime
    run: .\main.exe
    time_end: runtime
    silent: 1
    end

[gdb]
    goto: build
    run: gdb .\main.exe
    end

[main]
    goto: build

    goto: run 

    goto: clean
    end